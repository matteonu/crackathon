{
  "name": "studyphase-angular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editable study dashboard based on Karim's Figma skeleton and HS24 spreadsheet.",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "dev": "ng serve --host 0.0.0.0 --port 4173",
