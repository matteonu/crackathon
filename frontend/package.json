    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
