SECRET_KEY=change-me
# The PDF pipeline needs a key; put a personal OpenAI key here (never commit it).
OPENAI_API_KEY=
# Must be a model this key can actually call.
OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local development only: stands in for the proxy's X-User-Id header. Never set on the VM.
# DEV_USER=alice@ethz.ch
# Where the "Sign out" button goes. The default ends the VSETH login and the proxy session;
# set it to empty to hide the button.
# SIGN_OUT_URL=
# Course catalogue sync (backend/vvz/sync.py). All optional.
# VVZ_SEMESTERS=2026S,2026W,2027S   # default: previous, current and next two semesters
# VVZ_REFRESH_SECONDS=86400
# VVZ_AUTO_SYNC=0                   # do not build/refresh data/vvz.db in the background
